# ── Database ─────────────────────────────────────────────────────────────
# Local development (embedded Postgres started with `npm run db:local`):
DATABASE_URL="postgresql://tdc:tdc_local_demo@127.0.0.1:54329/tdc"
DIRECT_URL=""

# Neon: paste the strings exactly as Neon shows them in "Connect", with no extra path after the query string.
#   DATABASE_URL = pooled string   (host contains "-pooler") → used by the running app
#   DIRECT_URL   = direct string   (same host without "-pooler") → used by Prisma migrations
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── AI ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
# Leave false for live Gemini or manual categorization. True enables labeled demo rules.
DEMO_ANALYZER="true"

# Both AI features use gemini-2.5-flash. Free-tier availability depends on your Google project.
